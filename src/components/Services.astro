---
// Griglia dei servizi dello studio. Card sobrie: numero d'ordine come unico
// elemento grafico (funzionale, non decorativo), titolo e descrizione breve.
// `image` è uno slot previsto per il futuro; oggi non viene reso.
interface ServiceItem {
  title: string;
  description?: string;
  image?: string;
}
interface Props {
  services: ServiceItem[];
  heading?: string;
}
const { services, heading = 'Servizi' } = Astro.props;
---

<div class="mx-auto max-w-6xl px-6">
  <h2 class="text-3xl md:text-4xl">{heading}</h2>
  <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0">
    {
      services.map((s, i) => (
        <li class="card p-6 flex flex-col">
          <span class="text-sm font-medium tabular-nums text-[color:var(--accent)]" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-3 text-xl">{s.title}</h3>
          {s.description && (
            <p class="mt-2 text-[color:var(--muted)] text-pretty">{s.description}</p>
          )}
        </li>
      ))
    }
  </ul>
</div>
