---
import { Image } from 'astro:assets';
import Amenities from './Amenities.astro';
import { resolveClientImage } from '../lib/images';

interface Props {
  description?: string[];
  amenities?: string[];
  heading?: string;
  slug?: string;
  image?: string;
  imageAlt?: string;
}
const { description, amenities, heading = 'La struttura', slug, image, imageAlt } = Astro.props;
const hasAmenities = amenities && amenities.length > 0;
const hasDescription = description && description.length > 0;
const photo = slug && image ? resolveClientImage(slug, image) : null;
---

<div class="mx-auto max-w-6xl px-6">
  {
    photo ? (
      <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-14">
        <div>
          <h2 class="text-3xl md:text-4xl">{heading}</h2>
          {hasDescription && (
            <div class="mt-6 space-y-4 text-lg text-[color:var(--muted)]">
              {description!.map((p) => (
                <p class="text-pretty">{p}</p>
              ))}
            </div>
          )}
        </div>
        <Image
          src={photo}
          alt={imageAlt ?? heading}
          width={1400}
          height={934}
          widths={[560, 900, 1400]}
          sizes="(min-width: 768px) 45vw, 100vw"
          loading="lazy"
          class="w-full rounded-2xl border border-[color:var(--border)] object-cover shadow-sm md:aspect-[4/3]"
        />
      </div>
    ) : (
      <>
        <h2 class="text-3xl md:text-4xl">{heading}</h2>
        {hasDescription && (
          <div class="mt-6 max-w-2xl space-y-4 text-lg text-[color:var(--muted)]">
            {description!.map((p) => (
              <p class="text-pretty">{p}</p>
            ))}
          </div>
        )}
      </>
    )
  }
  {
    hasAmenities && (
      <div class="mt-10">
        <h3 class="text-sm uppercase tracking-wider text-[color:var(--muted)] mb-4">Servizi</h3>
        <Amenities items={amenities!} />
      </div>
    )
  }
</div>
