---
// Barra superiore sottile e sticky per i siti "studio": wordmark, azione
// "Chiama" e un menu a tendina (hamburger) con le sezioni, uguale a ogni
// larghezza. Si "solleva" con un'ombra quando la pagina scorre.
interface NavLink {
  href: string;
  label: string;
}
interface Props {
  name: string;
  phone?: string;
  links?: NavLink[];
}
const { name, phone, links = [] } = Astro.props;
const telHref = phone ? `tel:${phone.replace(/\s/g, '')}` : null;
const PHONE =
  '<path d="M13.83 19.11A15 15 0 0 1 4.89 10.17 2 2 0 0 1 6.18 7.7l1.9-.63a2 2 0 0 1 2.36 1.03l.66 1.45a2 2 0 0 1-.45 2.3l-.7.63a12 12 0 0 0 3.89 3.89l.63-.7a2 2 0 0 1 2.3-.45l1.45.66a2 2 0 0 1 1.03 2.36l-.63 1.9a2 2 0 0 1-2.47 1.29Z"/>';
---

<div class="site-header sticky top-0 z-40 border-b border-[color:var(--border)]" data-header>
  <div class="relative mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-6">
    <a href="#top" class="min-w-0 truncate text-[15px] font-semibold tracking-tight transition-colors hover:text-[color:var(--accent)]">{name}</a>

    <div class="flex items-center gap-1 sm:gap-3">
      {
        telHref && (
          <a
            href={telHref}
            aria-label={`Chiama ${phone}`}
            class="inline-flex shrink-0 items-center gap-2 rounded-full bg-[color:var(--accent)] px-3 py-2 text-sm font-medium text-[color:var(--accent-fg)] transition hover:opacity-90 sm:px-4"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={PHONE} />
            <span class="hidden sm:inline">Chiama</span>
          </a>
        )
      }

      {
        links.length > 0 && (
          <button
            type="button"
            class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-[color:var(--text)] transition-colors hover:bg-[color:var(--border)]/60"
            aria-label="Apri il menu"
            aria-expanded="false"
            aria-controls="site-menu"
            data-menu-toggle
          >
            <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg class="icon-close hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        )
      }
    </div>

    {
      links.length > 0 && (
        <nav
          id="site-menu"
          aria-label="Sezioni"
          hidden
          class="absolute right-6 top-full z-50 mt-2 w-56 overflow-hidden rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] shadow-xl"
          data-menu
        >
          <ul class="list-none p-1.5">
            {links.map((l) => (
              <li>
                <a href={l.href} class="block rounded-lg px-3 py-2.5 text-[15px] text-[color:var(--text)] transition-colors hover:bg-[color:var(--bg)] hover:text-[color:var(--accent)]" data-menu-link>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</div>

<script>
  // Menu a tendina + ombra dell'header allo scroll. Vanilla, nessuna dipendenza.
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const iconOpen = toggle?.querySelector('.icon-open');
  const iconClose = toggle?.querySelector('.icon-close');

  function setMenu(open: boolean) {
    if (!menu || !toggle) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });
  menu?.querySelectorAll('[data-menu-link]').forEach((a) =>
    a.addEventListener('click', () => setMenu(false)),
  );
  // Chiudi cliccando fuori o con Esc.
  document.addEventListener('click', (e) => {
    if (menu && !menu.hidden && !menu.contains(e.target as Node) && e.target !== toggle) {
      setMenu(false);
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
