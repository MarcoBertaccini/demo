---
// Barra superiore sottile e sticky per i siti "studio": wordmark a sinistra e
// azione "Chiama" a destra. Vetro smerigliato leggero sul fondo chiaro: dà
// l'aria di un sito reale e tiene la telefonata sempre a portata.
interface Props {
  name: string;
  phone?: string;
}
const { name, phone } = Astro.props;
const telHref = phone ? `tel:${phone.replace(/\s/g, '')}` : null;
const PHONE =
  '<path d="M13.83 19.11A15 15 0 0 1 4.89 10.17 2 2 0 0 1 6.18 7.7l1.9-.63a2 2 0 0 1 2.36 1.03l.66 1.45a2 2 0 0 1-.45 2.3l-.7.63a12 12 0 0 0 3.89 3.89l.63-.7a2 2 0 0 1 2.3-.45l1.45.66a2 2 0 0 1 1.03 2.36l-.63 1.9a2 2 0 0 1-2.47 1.29Z"/>';
---

<div
  class="sticky top-0 z-40 border-b border-[color:var(--border)]"
  style="background-color: color-mix(in srgb, var(--surface) 85%, transparent); backdrop-filter: saturate(1.4) blur(8px); -webkit-backdrop-filter: saturate(1.4) blur(8px);"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-6">
    <span class="min-w-0 truncate text-[15px] font-semibold tracking-tight">{name}</span>
    {
      telHref && (
        <a
          href={telHref}
          aria-label={`Chiama ${phone}`}
          class="inline-flex shrink-0 items-center gap-2 rounded-full bg-[color:var(--accent)] px-3 py-2 text-sm font-medium text-[color:var(--accent-fg)] transition hover:opacity-90 sm:px-4"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={PHONE} />
          <span class="hidden sm:inline">Chiama</span>
        </a>
      )
    }
  </div>
</div>
