---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Le demo non vanno indicizzate finché non passano su dominio proprio. -->
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
