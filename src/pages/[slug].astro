---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HeroText from '../components/HeroText.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Rooms from '../components/Rooms.astro';
import Gallery from '../components/Gallery.astro';
import Reviews from '../components/Reviews.astro';
import Location from '../components/Location.astro';
import Contact from '../components/Contact.astro';
import StickyWhatsApp from '../components/StickyWhatsApp.astro';
import SeoHead from '../components/SeoHead.astro';
import { whatsappLink } from '../lib/whatsapp';

// Una route per ogni file JSON in src/content/clients/. Lo slug è l'id.
export async function getStaticPaths() {
  const clients = await getCollection('clients');
  return clients.map((client) => ({
    params: { slug: client.id },
    props: { client },
  }));
}

const { client } = Astro.props;
const d = client.data;
const slug = client.id;

// "studio" = studio tecnico/professionale senza immagini: hero testuale, sezione
// servizi, niente camere/galleria/recensioni/WhatsApp. Default: B&B (lodging).
const isStudio = d.type === 'studio';

// Ogni sezione compare solo se ha dati: nessuna demo si rompe per un campo
// mancante. Se non c'è WhatsApp, la CTA e il bottone fisso spariscono.
const whatsappHref = whatsappLink(
  d.whatsapp,
  `Ciao ${d.name}, ho visto il vostro sito e vorrei qualche informazione.`,
);

const hasAbout = (d.description && d.description.length > 0) || (d.amenities && d.amenities.length > 0);
const hasServices = Boolean(d.services && d.services.length > 0);
const hasRooms = d.rooms && d.rooms.length > 0;
const hasGallery = d.gallery && d.gallery.length > 0;
const hasReviews = d.reviews && d.reviews.length > 0;
const hasLocation = Boolean(d.address || d.city || d.googleMapsUrl);
const hasContact = Boolean(
  d.phone || d.mobile || d.email || whatsappHref || d.address || d.city ||
    d.vat || d.facebookUrl || d.checkIn || d.checkOut,
);

// Voci del menu: solo le sezioni che verranno effettivamente renderizzate.
const navLinks = [
  hasAbout && { href: '#chi-siamo', label: 'Chi siamo' },
  hasServices && { href: '#servizi', label: 'Servizi' },
  hasLocation && { href: '#dove-siamo', label: 'Dove siamo' },
  hasContact && { href: '#contatti', label: 'Contatti' },
].filter(Boolean) as { href: string; label: string }[];

const metaDescription = d.tagline ?? d.description?.[0];
// Titolo pagina: per lo studio arricchito con la località (CAP rimosso).
const locality = d.city?.replace(/^\d{5}\s*/, '');
const pageTitle = isStudio && locality ? `${d.name} — ${locality}` : d.name;
const band = 'py-16 md:py-24';
---

<BaseLayout title={pageTitle} description={metaDescription} accent={d.accent} type={d.type}>
  <SeoHead slot="head" slug={slug} data={d} />

  {isStudio && <Header name={d.name} phone={d.phone} links={navLinks} />}

  {
    isStudio ? (
      <HeroText
        name={d.name}
        owner={d.owner}
        tagline={d.tagline}
        eyebrow="Studio Tecnico"
        phone={d.phone}
        mobile={d.mobile}
        email={d.email}
        address={d.address}
        city={d.city}
      />
    ) : (
      <Hero
        slug={slug}
        name={d.name}
        tagline={d.tagline}
        heroImage={d.heroImage}
        whatsappHref={whatsappHref}
        bookingUrl={d.bookingUrl}
      />
    )
  }

  <main>
    {
      hasAbout && (
        <Section class={band} id={isStudio ? 'chi-siamo' : undefined} aria-label={isStudio ? 'Chi siamo' : 'La struttura'}>
          <About
            description={d.description}
            amenities={isStudio ? undefined : d.amenities}
            heading={isStudio ? 'Chi siamo' : undefined}
          />
        </Section>
      )
    }

    {
      hasServices && (
        <Section class={`${band} bg-[color:var(--surface)]`} id="servizi" aria-label="Servizi">
          <Services services={d.services!} />
        </Section>
      )
    }

    {
      hasRooms && (
        <Section class={`${band} bg-[color:var(--surface)]`} aria-label="Camere">
          <Rooms slug={slug} rooms={d.rooms!} />
        </Section>
      )
    }

    {
      hasGallery && (
        <Section class={band} aria-label="Galleria">
          <Gallery slug={slug} images={d.gallery!} name={d.name} />
        </Section>
      )
    }

    {
      hasReviews && (
        <Section class={`${band} bg-[color:var(--surface)]`} aria-label="Recensioni">
          <Reviews reviews={d.reviews!.slice(0, 3)} />
        </Section>
      )
    }

    {
      hasLocation && (
        <Section class={band} id={isStudio ? 'dove-siamo' : undefined} aria-label="Dove siamo">
          <Location
            name={d.name}
            address={d.address}
            city={d.city}
            googleMapsUrl={d.googleMapsUrl}
            blurb={isStudio ? 'Apri le indicazioni stradali per raggiungere lo studio.' : undefined}
          />
        </Section>
      )
    }

    {
      hasContact && (
        <Section class={`${band} bg-[color:var(--surface)]`} id={isStudio ? 'contatti' : undefined} aria-label="Contatti">
          <Contact
            phone={d.phone}
            phoneLabel={isStudio ? 'Telefono e fax' : undefined}
            mobile={d.mobile}
            email={d.email}
            whatsappHref={whatsappHref}
            address={d.address}
            city={d.city}
            vat={d.vat}
            facebookUrl={d.facebookUrl}
            checkIn={d.checkIn}
            checkOut={d.checkOut}
          />
        </Section>
      )
    }
  </main>

  {whatsappHref && <StickyWhatsApp href={whatsappHref} />}
</BaseLayout>
