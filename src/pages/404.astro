---
import BaseLayout from '../layouts/BaseLayout.astro';

// GitHub Pages serve /404.html per i percorsi inesistenti.
---

<BaseLayout title="Pagina non trovata — Zenith Studio">
  <main class="min-h-[100svh] flex items-center justify-center px-6 text-center">
    <div>
      <p class="text-sm uppercase tracking-wider text-[color:var(--muted)]">Errore 404</p>
      <h1 class="mt-3 text-3xl md:text-4xl">Pagina non trovata</h1>
      <p class="mt-4 text-[color:var(--muted)]">
        L'anteprima che cerchi non esiste o è stata spostata.
      </p>
      <a href="https://zenith-studio.it" class="btn btn-accent mt-8" target="_blank" rel="noopener">
        Vai a zenith-studio.it
      </a>
    </div>
  </main>
</BaseLayout>
