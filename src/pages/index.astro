---
import BaseLayout from '../layouts/BaseLayout.astro';

// Root del dominio demo. NON elenca i clienti (per scelta): è solo una pagina
// neutra così il dominio nudo non restituisce un 404. Le demo vivono su /<slug>.
---

<BaseLayout title="Zenith Studio — Anteprime">
  <main class="min-h-[100svh] flex items-center justify-center px-6 text-center">
    <div>
      <p class="text-sm uppercase tracking-wider text-[color:var(--muted)]">Zenith Studio</p>
      <h1 class="mt-3 text-3xl md:text-4xl">Anteprime di siti per strutture ricettive</h1>
      <p class="mt-4 text-[color:var(--muted)]">
        Ogni anteprima ha un indirizzo dedicato che ti inviamo noi.
      </p>
      <a href="https://zenith-studio.it" class="btn btn-accent mt-8" target="_blank" rel="noopener">
        zenith-studio.it
      </a>
    </div>
  </main>
</BaseLayout>
